# Supabase project settings (Project Settings → API). Copy to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Free AI listing assistant (server-side only; never prefix with NEXT_PUBLIC_).
# Groq free tier: https://console.groq.com/keys. Leave empty to use keyword rules only.
GROQ_API_KEY=
# Optional: any OpenAI-compatible provider/model instead of the defaults.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
